extends RefCounted

const ROWS := [
	"...#....#................#.....#....",
	"..................#.................",
	"......#......#..................#...",
	".....................#..............",
	".#...........#................#..#..",
	".....................#..............",
	".....#...........#..................",
	"...........#...............#........",
	"...#................................",
	"......#........#..........#.........",
	"..................#................#",
	".........#.............#.......#....",
]

static func is_alt(cell: Vector2i) -> bool:
	var row: String = ROWS[posmod(cell.y, ROWS.size())]
	return row[posmod(cell.x, row.length())] == "#"
